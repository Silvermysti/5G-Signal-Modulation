# --- Never commit the dataset (huge + non-commercial license) ---
Data/
prepared/
*.npy
*.h5

# --- Trained weights: the live models/ dir is scratch, but each phase's
#     published weights ARE committed (a few MB each, and they let anyone
#     reproduce that phase's numbers without retraining). ---
models/
*.keras
!phases/*/models/
!phases/*/models/*.keras

# --- Colab upload bundles (huge, regenerable via data_prep.py + tar) ---
colab_uploads/
*.tar

# --- Never commit the virtual environment (huge, machine-specific) ---
.venv/

# --- The source paper (large binary; freely available on arXiv) ---
*.pdf

# --- Python junk ---
__pycache__/
*.pyc

# --- Editor/OS noise ---
.DS_Store

# --- Live-run scratch output (published figures live in phases/*/results/) ---
results/
